# This program determines whether an item should be recycled or placed in the trash.
# It asks the user to identify the material and, if eligible, enter its length and weight.
# The program uses these measurements to determine the appropriate disposal bin.

material = input("What material is it? ")

if material == "plastic" or material == "metal":
    waste_type = "recycling"

    length = float(input("What is its length in cm? "))
    weight = float(input("How much does the material weigh in lbs? "))

    print("Material entered:", material)
    print("Length entered:", length)
    print("Weight of material:", weight)

    if length < 7.5:
        waste_type = "trash"

    if weight < 3.0:
        waste_type = "trash"

else:
    waste_type = "trash"


print("Please deposit your item in the " + waste_type + " bin.")
